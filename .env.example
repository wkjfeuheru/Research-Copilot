# 复制为 .env 后按需修改。不要提交真实凭证。
# 数据库当前不连接；模型配置用于显式运行真实调用，测试默认不发起外部请求。

RC_ENVIRONMENT=development
RC_API_PREFIX=/api

# 数据库：当前留空即可。Compose 会为容器设置内部连接地址，但应用不会连接。
RC_DATABASE_URL=

# 研究模型：DeepSeek OpenAI 兼容接口。
# 官方当前模型名为 deepseek-flash / deepseek-v4-pro；
# deepseek-chat 已被官方宣布于 2026-07-24 下线，只有兼容网关仍支持时才手动填写。
RC_RESEARCH_MODEL=deepseek-flash
RC_RESEARCH_MODEL_BASE_URL=https://api.deepseek.com
RC_RESEARCH_MODEL_API_KEY=
RC_RESEARCH_MODEL_TIMEOUT_SECONDS=60
RC_RESEARCH_MODEL_MAX_TOKENS=8192

# Docker Compose 本地开发默认值；部署前必须替换为独立强密码。
POSTGRES_DB=research_copilot
POSTGRES_USER=research_copilot
POSTGRES_PASSWORD=research_copilot_local_dev
APP_PORT=8080
