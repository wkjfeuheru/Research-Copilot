# 复制为 .env 后按需修改。不要提交真实凭证。
# 阶段一并不连接数据库，也不调用模型；以下配置只描述后续接入位置。

RC_ENVIRONMENT=development
RC_API_PREFIX=/api

# 数据库：阶段一留空即可。Compose 会为容器设置内部连接地址，但应用不会连接。
RC_DATABASE_URL=

# 研究模型：阶段一不发起调用，可全部留空。
RC_RESEARCH_MODEL=
RC_RESEARCH_MODEL_API_KEY=

# Docker Compose 本地开发默认值；部署前必须替换为独立强密码。
POSTGRES_DB=research_copilot
POSTGRES_USER=research_copilot
POSTGRES_PASSWORD=research_copilot_local_dev
APP_PORT=8080
