# 本地配置。仅保存示例，不要提交真实密钥。
# 当前 Web/CLI 的模型地址和角色绑定由 --models 指向的 TOML 决定。

# 必填：数据库与示例模型 provider 的密钥。
RC_DATABASE_URL=postgresql://research_copilot:research_copilot_local_dev@127.0.0.1:5432/research_copilot
RC_DEEPSEEK_API_KEY=
# 仅模型 provider 使用；不会覆盖模型 TOML 的 providers.*.base_url。
RC_DEEPSEEK_BASE_URL=https://api.deepseek.com

# FinanceKB 六域 MCP（market/fundamentals/macro/news/knowledge/futures）。
# 同时设置 HTTPS 源站与 Bearer 令牌；源站只接受 origin，不接受路径或查询参数。
RC_FINANCEKB_BASE_URL=
RC_FINANCEKB_API_TOKEN=
# 可选：本机受信 CA 文件；仅传给 FinanceKB 客户端，保留证书链与主机名校验。
RC_FINANCEKB_CA_BUNDLE=
# 可选：单次 FinanceKB 调用期限（含队列等待），默认 150 秒。
RC_FINANCEKB_CALL_TIMEOUT_SECONDS=150

# Web 身份；命令行 --actor-id 优先。只接受字母、数字、下划线、连字符。
RC_ACTOR_ID=local

# Compose 本地 PostgreSQL。连接串端口和凭证须与下面设置一致。
POSTGRES_DB=research_copilot
POSTGRES_USER=research_copilot
POSTGRES_PASSWORD=research_copilot_local_dev
POSTGRES_HOST_PORT=5432

# 模型：复制 config/models.example.toml 为 config/models.local.toml。
# 预算/沙盒/合规规则请修改对应 TOML/YAML 或传 --execution-policy / --rules。
# 工作区使用 --workspace；根目录 skills/ 不参与运行。
