{
  "$defs": {
    "Capability": {
      "description": "规划步骤所需的研究能力。",
      "enum": [
        "evidence_acquisition",
        "analysis",
        "risk_check",
        "reporting"
      ],
      "title": "Capability",
      "type": "string"
    },
    "DataRequirement": {
      "additionalProperties": false,
      "description": "一项数据需求。",
      "properties": {
        "requirement_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "description": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "material_types": {
          "items": {
            "$ref": "#/$defs/MaterialType"
          },
          "minItems": 1,
          "title": "Material Types",
          "type": "array"
        },
        "metrics": {
          "items": {
            "maxLength": 8000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Metrics",
          "type": "array"
        },
        "period": {
          "anyOf": [
            {
              "maxLength": 8000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period"
        },
        "purpose": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "description",
        "material_types",
        "purpose"
      ],
      "title": "DataRequirement",
      "type": "object"
    },
    "MaterialType": {
      "description": "数据需求的资料类型。",
      "enum": [
        "financial_statement",
        "market_data",
        "industry_report",
        "company_announcement",
        "news",
        "attachment",
        "other"
      ],
      "title": "MaterialType",
      "type": "string"
    },
    "PlanStep": {
      "additionalProperties": false,
      "description": "一个研究步骤；只描述意图和依赖，不代表实际执行顺序。",
      "properties": {
        "step_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Step Id",
          "type": "string"
        },
        "intent": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Intent",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "minItems": 1,
          "title": "Capabilities",
          "type": "array"
        },
        "depends_on": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "data_requirement_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "title": "Data Requirement Ids",
          "type": "array"
        },
        "skill_ids": {
          "items": {
            "maxLength": 8000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Skill Ids",
          "type": "array"
        }
      },
      "required": [
        "step_id",
        "intent",
        "capabilities"
      ],
      "title": "PlanStep",
      "type": "object"
    },
    "PlanningStatus": {
      "description": "规划状态。",
      "enum": [
        "ready",
        "needs_clarification",
        "unsupported"
      ],
      "title": "PlanningStatus",
      "type": "string"
    },
    "ResearchObjectType": {
      "description": "研究对象/问题类型。",
      "enum": [
        "stock",
        "industry",
        "company_comparison"
      ],
      "title": "ResearchObjectType",
      "type": "string"
    },
    "ResearchObjective": {
      "additionalProperties": false,
      "description": "研究目标、分析维度与显式假设。",
      "properties": {
        "goal": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "analysis_dimensions": {
          "items": {
            "maxLength": 8000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Analysis Dimensions",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "maxLength": 8000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        }
      },
      "required": [
        "goal"
      ],
      "title": "ResearchObjective",
      "type": "object"
    },
    "ResearchScope": {
      "additionalProperties": false,
      "description": "研究对象与范围。",
      "properties": {
        "object_type": {
          "$ref": "#/$defs/ResearchObjectType"
        },
        "subject": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "unresolved_references": {
          "items": {
            "$ref": "#/$defs/UnresolvedReference"
          },
          "title": "Unresolved References",
          "type": "array"
        }
      },
      "required": [
        "object_type",
        "subject"
      ],
      "title": "ResearchScope",
      "type": "object"
    },
    "UnresolvedReference": {
      "additionalProperties": false,
      "description": "模型无法确定、需要后续解析或澄清的对象。",
      "properties": {
        "kind": {
          "$ref": "#/$defs/UnresolvedReferenceKind"
        },
        "reference": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "reason": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reference",
        "reason"
      ],
      "title": "UnresolvedReference",
      "type": "object"
    },
    "UnresolvedReferenceKind": {
      "description": "待解析对象的类型。",
      "enum": [
        "stock_code",
        "date",
        "entity",
        "other"
      ],
      "title": "UnresolvedReferenceKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Planner 的独立输出。",
  "properties": {
    "status": {
      "$ref": "#/$defs/PlanningStatus"
    },
    "research_scope": {
      "$ref": "#/$defs/ResearchScope"
    },
    "objective": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResearchObjective"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "data_requirements": {
      "items": {
        "$ref": "#/$defs/DataRequirement"
      },
      "title": "Data Requirements",
      "type": "array"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/PlanStep"
      },
      "title": "Steps",
      "type": "array"
    },
    "clarification_questions": {
      "items": {
        "maxLength": 8000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Clarification Questions",
      "type": "array"
    },
    "unsupported_reason": {
      "anyOf": [
        {
          "maxLength": 8000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unsupported Reason"
    }
  },
  "required": [
    "status",
    "research_scope"
  ],
  "title": "PlannerOutput",
  "type": "object"
}
