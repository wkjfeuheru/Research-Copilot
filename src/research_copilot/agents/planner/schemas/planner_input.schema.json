{
  "$defs": {
    "AttachmentMetadata": {
      "additionalProperties": false,
      "description": "附件元信息；不携带文件内容或服务器路径。",
      "properties": {
        "attachment_id": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Attachment Id",
          "type": "string"
        },
        "filename": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "content_type": {
          "anyOf": [
            {
              "maxLength": 8000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Type"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 8000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "attachment_id",
        "filename"
      ],
      "title": "AttachmentMetadata",
      "type": "object"
    },
    "MarketScope": {
      "description": "当前阶段只接受 A 股研究范围。",
      "enum": [
        "a_share"
      ],
      "title": "MarketScope",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Planner 的独立输入。",
  "properties": {
    "research_question": {
      "maxLength": 8000,
      "minLength": 1,
      "title": "Research Question",
      "type": "string"
    },
    "market_scope": {
      "$ref": "#/$defs/MarketScope",
      "default": "a_share"
    },
    "cutoff_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cutoff Date"
    },
    "selected_skill_ids": {
      "items": {
        "maxLength": 8000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Selected Skill Ids",
      "type": "array"
    },
    "attachments": {
      "items": {
        "$ref": "#/$defs/AttachmentMetadata"
      },
      "title": "Attachments",
      "type": "array"
    },
    "user_notes": {
      "anyOf": [
        {
          "maxLength": 8000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "User Notes"
    }
  },
  "required": [
    "research_question"
  ],
  "title": "PlannerInput",
  "type": "object"
}
