{
  "name": "research-copilot-frontend",
  "private": true,
  "version": "0.1.0",
  "researchCopilotApiVersion": "1",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "vite --open /",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build && uv run --project .. --frozen rc seal-web dist --frontend-source .",
    "preview": "vite preview"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
